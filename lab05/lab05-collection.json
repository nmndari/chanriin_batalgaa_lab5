{
  "info": {
    "name": "Lab05 - Course Registration API",
    "description": "Лаборатори 5 — Хичээлд бүртгүүлэх API-ийн тест",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" }
  ],
  "item": [
    {
      "name": "Даалгавар 1 - Анхны хүсэлт ба oracle",
      "item": [
        {
          "name": "Setup: идэвхтэй, CS201 үзсэн оюутан",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"active\",\n  \"coursesTaken\": [\"CS201\"]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/students/B231234567"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Setup: оюутан үүссэн (200)\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Setup: CS201 урьдач нөхцөлтэй CS313 хичээл",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"prerequisites\": [\"CS201\"]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/courses/CS313"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Setup: хичээл үүссэн (200)\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /registrations - амжилттай бүртгэл",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"studentID\": \"B231234567\",\n  \"courseID\": \"CS313\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/registrations"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Oracle 1: статус код",
                  "pm.test(\"Статус 201 байна\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "// Oracle 2: хариуны утга",
                  "pm.test(\"result нь OK байна\", function () {",
                  "    pm.expect(pm.response.json().result).to.eql(\"OK\");",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
